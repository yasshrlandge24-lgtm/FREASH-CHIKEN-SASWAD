# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freash-chiken?schema=public"

# Long random string used to sign session JWTs — generate with `openssl rand -base64 32`
JWT_SECRET="change-this-to-a-long-random-string"

# Base URL of the running app (used for absolute links, e.g. in emails later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment provider mode — "mock" (default, no real charges) or a real provider key
# once one is implemented in src/lib/payments.ts (e.g. "razorpay")
PAYMENT_MODE="mock"

# Payment (required only when PAYMENT_MODE=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_PAYMENT_MODE=mock

