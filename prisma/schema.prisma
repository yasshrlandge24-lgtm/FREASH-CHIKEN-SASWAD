// ============================================================
// Freash Chiken — Prisma schema
// Local Phase 1 setup uses `npx prisma db push` after setting DATABASE_URL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CouponType {
  PERCENT
  FLAT
}

// ------------------------------------------------------------
// Core models
// ------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  reviews       Review[]
  couponUsages  CouponUsage[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Address {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     AddressType @default(HOME)
  name      String
  phone     String
  line1     String
  area      String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId])
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  products     Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  sku           String   @unique
  tags          String[] @default([])

  // content sections (rendered as tabs on the product page)
  sourcingInfo   String?
  processingInfo String?
  hygieneInfo    String?
  storageInfo    String?
  deliveryInfo   String?
  nutritionInfo  Json?

  active       Boolean   @default(true)
  ratingAvg    Float     @default(0)
  ratingCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlisted  WishlistItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
}

// A variant = one purchasable combination of weight + cut for a product.
model ProductVariant {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  weightLabel  String   // "500g", "1kg"
  weightGrams  Int
  cutOption    String?  // "Boneless", "Curry Cut", null if not applicable
  price        Int      // in smallest currency unit (paise) OR whole rupees — pick one convention and stay consistent
  mrp          Int
  sku          String   @unique
  active       Boolean  @default(true)

  inventory    Inventory?
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@unique([productId, weightLabel, cutOption])
}

model Inventory {
  id               String         @id @default(cuid())
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId        String         @unique
  availableStock   Int            @default(0)
  reservedStock    Int            @default(0)
  soldQuantity     Int            @default(0)
  lowStockThreshold Int           @default(10)
  updatedAt        DateTime       @updatedAt
}

// ------------------------------------------------------------
// Cart / Wishlist
// ------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

model Wishlist {
  id     String         @id @default(cuid())
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String         @unique
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ------------------------------------------------------------
// Coupons
// ------------------------------------------------------------

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           CouponType
  value          Int          // percent (0-100) or flat amount, per `type`
  minOrderAmount Int          @default(0)
  maxDiscount    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?         // total uses allowed, null = unlimited
  perUserLimit   Int?         @default(1)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  usages         CouponUsage[]
  orders         Order[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  order    Order?   @relation(fields: [orderId], references: [id])
  orderId  String?  @unique
  usedAt   DateTime @default(now())

  @@index([couponId, userId])
}

// ------------------------------------------------------------
// Orders
// ------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  status          OrderStatus   @default(PLACED)

  subtotal        Int
  itemDiscount    Int           @default(0)
  deliveryFee     Int           @default(0)
  couponDiscount  Int           @default(0)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  grandTotal      Int

  deliverySlot    DeliverySlot? @relation(fields: [deliverySlotId], references: [id])
  deliverySlotId  String?
  deliveryDate    DateTime

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  shippingAddress OrderAddress?
  payment         Payment?
  couponUsage     CouponUsage?
  statusHistory   OrderStatusEvent[]

  @@index([userId])
}

model OrderItem {
  id         String         @id @default(cuid())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product        @relation(fields: [productId], references: [id])
  productId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  quantity   Int
  unitPrice  Int            // price at time of order (never trust cart-cached price at checkout time — recompute)
  lineTotal  Int
}

// Snapshot of the address at time of order — independent of the User's saved Address,
// which may change or be deleted later.
model OrderAddress {
  id       String      @id @default(cuid())
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String      @unique
  label    AddressType
  name     String
  phone    String
  line1    String
  area     String
  landmark String?
  city     String
  state    String
  pincode  String
}

model Payment {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Int
  providerRef   String?       // reference id from a real payment gateway, once integrated
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Append-only audit trail of status changes, so "order timeline" is real data, not guessed from `status` alone.
model OrderStatusEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------
// Delivery
// ------------------------------------------------------------

model DeliverySlot {
  id           String   @id @default(cuid())
  label        String   // "12 PM - 2 PM"
  startTime    String   // "12:00"
  endTime      String   // "14:00"
  date         DateTime // specific date this slot instance applies to
  capacity     Int      @default(50)
  bookedCount  Int      @default(0)
  deliveryFee  Int      @default(40)
  active       Boolean  @default(true)

  orders       Order[]

  @@index([date])
}

model ServiceArea {
  id      String  @id @default(cuid())
  pincode String  @unique
  city    String
  active  Boolean @default(true)
}

// ------------------------------------------------------------
// Reviews / Notifications / Banners
// ------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  rating     Int      // 1-5
  text       String
  verified   Boolean  @default(false)
  approved   Boolean  @default(true)
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  placement    String   // "hero" | "promo" | "featured-category" etc.
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
}
